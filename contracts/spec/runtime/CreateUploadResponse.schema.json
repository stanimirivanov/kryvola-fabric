{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "upload_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "upload_id"
  ],
  "additionalProperties": false
}
