{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "plan_ref": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "tenant_scope": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "immutable_version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "tenant_scope",
        "plan_id",
        "immutable_version",
        "plan_digest"
      ],
      "additionalProperties": false
    },
    "approval_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "plan_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,43691}(?![\\s\\S])"
    },
    "consent_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,10923}(?![\\s\\S])"
    },
    "approval_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,10923}(?![\\s\\S])"
    },
    "signature_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,2731}(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "plan_ref",
    "approval_digest",
    "plan_base64url",
    "consent_base64url",
    "approval_base64url",
    "signature_base64url"
  ],
  "additionalProperties": false
}
