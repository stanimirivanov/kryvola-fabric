{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "tenant_scope": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    }
  },
  "required": [
    "schema_version",
    "tenant_scope",
    "byte_length"
  ],
  "additionalProperties": false
}
